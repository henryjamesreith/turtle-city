{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist-server",
    "target": "ES2022"
  },
  "include": [
    "server/**/*.ts",
    "lib/multiplayer/districts.ts",
    "lib/multiplayer/schema.ts",
    "lib/turtles.ts"
  ],
  "exclude": ["node_modules"]
}
