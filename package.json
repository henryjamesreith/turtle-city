{
  "name": "turtle-city",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run multiplayer:build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "multiplayer:build": "tsc --project tsconfig.server.json",
    "multiplayer:dev": "node --watch --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx server/index.ts",
    "multiplayer:start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env dist-server/server/index.js",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.46",
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/ws-transport": "^0.17.13",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.111.0",
    "express": "^5.2.1",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "^2.110.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "ws": "8.21.1"
  },
  "type": "module"
}
